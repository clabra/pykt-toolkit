direction: up

BKT: {
  class: input_layer
  label: BKT
}

InputData: {
  class: input_layer
  label: Interactions \n Data
}
InputData.shape: rectangle

# 1. Embeddings Layer

EmbeddingsLayer: {
  # 2. Embeddings Stage
  Embeddings: {
    class: process_layer
    label: |md
      Individualized Embeddings

      x'ₜ (Current Task)

      y'ₜ (History)
    |
  }

  Embeddings.shape: rectangle
}

# 3. Attention Heads (Transformer)
Transformer: {
  class: transformer_core

  Encoder: {
    label: "Encoder\n(Self-Attention on y'_{1:t-1})"
  }

  Decoder: {
    label: "Decoder\n(Cross-Attention + x'ₜ)"
  }

  # 4. Intermediate Context Vector
  zt: {
    shape: rectangle
    label: "zₜ \n Context Vector"
    style: {
      fill: "#ffffff"
      stroke-width: 2
    }
  }

  Encoder -> Decoder: "History Context"
  Decoder -> zt
}

# 5. Output Layer
Outputs: {
  PredictionHead: {
    class: output_head
    label: "p_res \n Supervised"
  }

  GroundedReadout: {
    class: output_head
    label: "p_L0 \n Grounded"
  }

  GroundedReadout2: {
    class: output_head
    label: "p_T \n Grounded"
  }
}

# 6. Multi-objective Loss Functions

LossLayer: {
  LossSupervised
  LossRegularization
  LossGrounded
}

# Relationships / Flow
BKT -> EmbeddingsLayer.Embeddings: p_l0, p_T
InputData -> EmbeddingsLayer.Embeddings: "{(q, c, r)}"
EmbeddingsLayer.Embeddings -> Transformer.Encoder: "y'_{1:t-1}"
EmbeddingsLayer.Embeddings -> Transformer.Decoder: "x'ₜ"

Transformer.zt -> Outputs.PredictionHead

# Loss functions
Outputs -> LossLayer

# Define Classes for visual consistency
classes: {
  input_layer: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
      border-radius: 8
    }
  }
  process_layer: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  transformer_core: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  output_head: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  loss_box: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-dash: 5
      stroke-width: 2
    }
  }
}

