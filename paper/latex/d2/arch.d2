direction: up

BKT: {
  class: input
  label: BKT
}

InputData: {
  class: input
  label: Interactions \n Data
}
InputData.shape: cylinder

# 1. Embeddings Layer

EmbeddingsLayer: {
  class: layer
  label: Embeddings
  Embeddings: {
    class: embeddings
    label: |md
      Individualized Embeddings

      x'ₜ (Current Task)

      y'ₜ (History)
    |
  }

  Embeddings.shape: rectangle
}

# 3. Attention Heads (Transformer)
Transformer: {
  class: transformer

  Encoder: {
    class: transformer_component
    style.multiple: true
    label: "Encoder\n(Self-Attention on y'_{1:t-1})"
  }

  Decoder: {
    class: transformer_component
    style.multiple: true
    label: "Decoder\n(Cross-Attention + x'ₜ)"
  }

  # 4. Intermediate Context Vector
  zt: {
    class: transformer_component
    label: "zₜ \n Context Vector"
  }

  Encoder -> Decoder: "History Context"
  Decoder -> zt
}

# 5. Output Layer
Outputs: {
  class: layer

  SupervisedOut: {
    class: component
    label: "Supervised \n p_res"

    linear
    softmax
    linear -> softmax
  }

  GroundedOut1: {
    class: component
    label: "Grounded \n p_L0"

    linear
    softmax
    linear -> softmax
  }

  GroundedOut2: {
    class: component
    label: "Grounded \n p_T"

    linear
    softmax
    linear -> softmax
  }
}

# 6. Multi-objective Loss Functions

LossLayer: {
  label: Losses
  class: layer
  LossSupervised: {
    label: + \n Sup
    class: loss
  }
  LossRegularization: {
    label: + \n Reg
    class: loss
  }
  LossGrounded1: {
    label: + \n p_L0
    class: loss
  }
  LossGrounded2: {
    label: + \n p_T
    class: loss
  }
}

# Relationships / Flow
BKT -> EmbeddingsLayer.Embeddings: p_l0, p_T
InputData -> EmbeddingsLayer.Embeddings: "{(q, c, r)}"
EmbeddingsLayer.Embeddings -> Transformer.Encoder: "y'_{1:t-1}"
EmbeddingsLayer.Embeddings -> Transformer.Decoder: "x'ₜ"

Transformer.zt -> Outputs.SupervisedOut
Transformer.zt -> Outputs.GroundedOut1
Transformer.zt -> Outputs.GroundedOut2

# Loss functions
Outputs.SupervisedOut -> LossLayer.LossSupervised
Outputs.GroundedOut1 -> LossLayer.LossGrounded1: {
  style: {
    # All CSS color names are valid
    stroke: deepskyblue
  }
}

Outputs.GroundedOut1 -> LossLayer.LossRegularization: {
  style: {
    # All CSS color names are valid
    stroke: brown
  }
}
Outputs.GroundedOut2 -> LossLayer.LossGrounded2: {
  style: {
    # All CSS color names are valid
    stroke: green
  }
}
Outputs.GroundedOut2 -> LossLayer.LossRegularization: {
  style: {
    # All CSS color names are valid
    stroke: brown
  }
}

InputData -> LossLayer.LossSupervised
BKT -> LossLayer.LossGrounded1: p_L0 {
  style: {
    # All CSS color names are valid
    stroke: deepskyblue
  }
}
BKT -> LossLayer.LossGrounded2: p_T {
  style: {
    # All CSS color names are valid
    stroke: green
  }
}

# Define Classes for visual consistency
classes: {
  layer: {
    style: {
      stroke: "#000000"
      stroke-width: 2
      border-radius: 8
      stroke-dash: 5
      shadow: true
    }
  }

  component: {
    style: {
      stroke: "#000000"
      stroke-width: 2
      shadow: true
    }
  }

  loss: {
    style: {
      stroke: "#000000"
      stroke-width: 2
      shadow: true
    }
    shape: circle
  }

  transformer: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
      shadow: true
    }
  }

  transformer_component: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
      shadow: true
    }
  }

  input: {
    style: {
      fill: "#ffffff"
      stroke: "#000000"
      stroke-width: 2
      shadow: true
    }
  }

  embeddings: {
    style: {
      stroke: "#000000"
      stroke-width: 2
      shadow: true
      3d: true
    }
  }
}

