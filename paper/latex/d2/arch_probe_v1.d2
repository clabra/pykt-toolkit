direction: up

** {
  style: {
    font-size: 85
  }
}

MainContainer: {
  label: "Model Architecture"
  style: {
    stroke: "#666666"
    stroke-width: 4
    fill: "#f9f9f9"
    border-radius: 12
    font-size: 100
  }

# ============================================================================
# 1: INPUT COMPONENTS
# ============================================================================

Section1: {
  label: "1: Input Components"
  style: {
    stroke: "#000000"
    stroke-width: 4
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  BKT: {
    label: |md

      Reference Model

      BKT

      p<sub>L₀</sub>, p<sub>T</sub>
    |
    shape: cylinder
    style: {
      fill: "#d4edda"
      stroke: "#000000"
      stroke-width: 4
      shadow: true
    }
  }


  InputData: {
    label: |md
      Interaction 
      
      Data

      {(q, c, r)}
    |
    shape: cylinder
    style: {
      fill: "#d4e6f1"
      stroke: "#000000"
      stroke-width: 4
      shadow: true
    }
  }

}

# ============================================================================
# 2: EMBEDDINGS LAYER
# ============================================================================

Section2: {
  label: "2: Embeddings Layer"
  style: {
    stroke: "#000000"
    stroke-width: 4
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  StandardEmbeddings: {
    label: "Standard Track (Blue)"
    style: {
      stroke: "#2874A6"
      stroke-width: 3
      stroke-dash: 5
      fill: "#EBF5FB"
      font-size: 90
    }
    
    TaskHistoryEmb: {
      label: |md
        History Embeddings
        (Response + Difficulty)
        
        y'<sub>t</sub> = e + u·f
        
        e: Interaction = qa_emb(r) + q_emb(q)

        f: Interaction Variation = qa_diff(r) + q_diff(q)

        u: Problem Difficulty (scalar)
        
        <span style="color:#666">e, f: [d]    u: scalar    y': [d]</span>

        <span style="color:#666">[B, S, d]</span>
      |
      shape: rectangle
      style: {
        fill: "#e8f4f8"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    TaskHistoryEmb2: {
      label: |md
        Task Embeddings
        (Question + Difficulty)
        
        x'<sub>t</sub> = c + u·d
        
        c: Question/Skill Embedding = q_emb(q)

        d: Question Variation = q_diff(q)

        u: Problem Difficulty (scalar)
        
        <span style="color:#666">c, d: [d]    u: scalar    x': [d]</span>

        <span style="color:#666">[B, S, d]</span>
      |
      shape: rectangle
      style: {
        fill: "#e8f4f8"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
  }
  
  InterpretableEmbeddings: {
    label: "Interpretable Track (Green)"
    style: {
      stroke: "#229954"
      stroke-width: 3
      stroke-dash: 5
      fill: "#EAFAF1"
      font-size: 90
    }
    
    TheoryBases: {
      label: |md
        Theory Bases
        (BKT Priors)
        
        L₀<sub>base</sub>[q] ~ N(σ⁻¹(BKT_L₀[q]), 0.05)

        T<sub>base</sub>[q] ~ N(σ⁻¹(BKT_T[q]), 0.05)
        
        <span style="color:#666">Textured logits from BKT</span>

        <span style="color:#666">[n_question+1, 1]</span>
      |
      shape: rectangle
      style: {
        fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    SemanticAxes: {
      label: |md
        Semantic Axes
        (Relational Directions)
        
        K<sub>axis</sub>[q]: Knowledge Direction

        V<sub>axis</sub>[q]: Velocity Direction
        
        <span style="color:#666">Init: Orthogonal(0, 0.02)</span>

        <span style="color:#666">[n_question+1, z]</span>

        <span style="color:#666">z = d + e</span>
      |
      shape: rectangle
      style: {
        fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
  }
  
}

# ============================================================================
# 3: TRANSFORMER ARCHITECTURE
# ============================================================================

Section3: {
  label: "3: Transformer Architecture"
  style: {
    stroke: "#000000"
    stroke-width: 4
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  Encoder: {
    label: |md
      Encoder

      (Self-Attention)

      y'<sub>1:t-1</sub>
      
      <span style="color:#666">[B, S, d]</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#000000"
      stroke-width: 4
      multiple: true
      shadow: true
    }
  }
  
  Decoder: {
    label: |md
      Decoder

      (Cross-Attention)

      x'<sub>t</sub>
      
      <span style="color:#666">[B, S, d]</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#000000"
      stroke-width: 4
      multiple: true
      shadow: true
    }
  }
  
  ContextVector: {
    label: |md
      Context Vector

      z<sub>t</sub> = d<sub>out</sub> ⊕ q<sub>emb</sub>

      (High-dim Latent)
      
      <span style="color:#666">[B, S, z]</span>

      <span style="color:#666">z = d + e</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#000000"
      stroke-width: 4
      shadow: true
    }
  }
  
  Encoder -> Decoder: "History Context" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
  Decoder -> ContextVector { style: { stroke: "#000000"; stroke-width: 4 } }
}

# ============================================================================
# 4: GROUNDED PARAMETERS (THREE-COMPONENT COMPOSITION)
# ============================================================================

Section4: {
  label: "4: Grounded Parameters (Base + Projection)"
  style: {
    stroke: "#000000"
    stroke-width: 4
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  TheoryBase: {
    label: |md
      1. Theory Base

      (BKT Prior Embeddings)
      
      ℓ<sub>L₀</sub>[q] = L₀<sub>base</sub>[q]

      ℓ<sub>T</sub>[q] = T<sub>base</sub>[q]
      
      <span style="color:#666">Textured logits ~ N(σ⁻¹(BKT), 0.05)</span>

      <span style="color:#666">[B, S]</span>
    |
    shape: rectangle
    style: {
        fill: "#d4edda"
      stroke: "#000000"
      stroke-width: 4
      shadow: true
    }
  }
  
  SemanticProjection: {
    label: |md
      2. Semantic Axis Projection

      (Context · Relational Direction)
      
      Δ<sub>L₀</sub> = z<sub>t</sub> · K<sub>axis</sub>[q]

      Δ<sub>T</sub> = z<sub>t</sub> · V<sub>axis</sub>[q]
      
      <span style="color:#666">Dot product: sum(z ⊙ axis, dim=-1)</span>

      <span style="color:#666">[B, S]</span>
    |
    shape: rectangle
    style: {
        fill: "#d4edda"
      stroke: "#000000"
      stroke-width: 4
      shadow: true
    }
  }
  
  FinalParams: {
    label: |md
      2. Final Parameters

      (Sigmoid Activation)
      
      p<sub>L₀</sub> = σ(ℓ<sub>L₀</sub>)

      p<sub>T</sub> = σ(ℓ<sub>T</sub>)
      
      <span style="color:#666">[B, S]</span>
    |
    shape: rectangle
    style: {
      fill: "#d4edda"
      stroke: "#000000"
      stroke-width: 4
      shadow: true
    }
  }
  
  TheoryBase -> FinalParams: "Base +" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
  SemanticProjection -> FinalParams: "Context Projection " { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
}

# ============================================================================
# 5: OUTPUTS & MULTI-OBJECTIVE LOSS
# ============================================================================

Section5: {
  label: "5: Outputs & Multi-Objective Loss"
  style: {
    stroke: "#000000"
    stroke-width: 4
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  Outputs: {
    label: "Output Heads"
    style: {
      stroke: "#000000"
      stroke-width: 4
      stroke-dash: 5
      fill: "#ffffff"
      font-size: 90
    }
    
    SupervisedOut: {
      label: |md
        Supervised Prediction
        
        ŷ<sub>t</sub> = MLP(z<sub>t</sub>)
        
        <span style="color:#666">[B, S]</span>
      |
      shape: rectangle
      style: {
          fill: "#d4e6f1"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    ReferenceOut: {
      label: |md
        Reference Output

        (BKT Logic)
        
        ŷ<sub>ref</sub> = BKT(p<sub>L₀</sub>, p<sub>T</sub>)
        
        <span style="color:#666">[B, S]</span>
      |
      shape: rectangle
      style: {
          fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    DiagnosticProbes: {
      label: |md
        Diagnostic Probes

        (Latent Diagnostics)
        
        p̂<sub>L₀</sub> = Linear(z<sub>t</sub>)

        p̂<sub>T</sub>  = Linear(z<sub>t</sub>)
        
        <span style="color:#666">[B, S]</span>
      |
      shape: rectangle
      style: {
          fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
  }
  
  Loss: {
    label: "Multi-Objective Loss"
    style: {
      stroke: "#000000"
      stroke-width: 4
      stroke-dash: 5
      fill: "#ffffff"
      font-size: 90
    }
    
    LossSup: {
      label: |md
        ℒ<sub>sup</sub>
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle
      style: {
        fill: "#d4e6f1"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    LossRef: {
      label: |md
        ℒ<sub>ref</sub>
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle
      style: {
        fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    LossProbe: {
      label: |md
        ℒ<sub>probe</sub>

        (Probe Alignment)
        
        MSE(p̂<sub>L₀</sub>, μ<sub>L₀</sub>) + MSE(p̂<sub>T</sub>, μ<sub>T</sub>)
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle  
      style: {
        fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    TotalLoss: {
      label: |md
        Total Loss
        
        ℒ = λ<sub>sup</sub>·ℒ<sub>sup</sub> + λ<sub>ref</sub>·ℒ<sub>ref</sub> + λ<sub>probe</sub>·ℒ<sub>probe</sub>
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle
      style: {
        fill: "#d4edda"
        stroke: "#000000"
        stroke-width: 4
        shadow: true
      }
    }
    
    LossSup -> TotalLoss: "" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
    LossRef -> TotalLoss: "" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
    LossProbe -> TotalLoss: "" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
  }
  
  Outputs.SupervisedOut -> Loss.LossSup { style: { stroke: "#000000"; stroke-width: 4 } }
  Outputs.ReferenceOut -> Loss.LossRef { style: { stroke: "#000000"; stroke-width: 4 } }
  Outputs.DiagnosticProbes -> Loss.LossProbe { style: { stroke: "#000000"; stroke-width: 4 } }
}

# ============================================================================
# DATA FLOW CONNECTIONS BETWEEN SECTIONS
# ============================================================================

# 1 -> 2
Section1.BKT -> Section1.InputData: "Priors" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
Section1.InputData -> Section2.StandardEmbeddings.TaskHistoryEmb: "" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
Section1.BKT -> Section2.InterpretableEmbeddings.TheoryBases: "Load" { style: { stroke: "#229954"; stroke-width: 4; font-size: 80 } }

# 2 -> 3
Section2.StandardEmbeddings.TaskHistoryEmb -> Section3.Encoder: "" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }
Section2.StandardEmbeddings.TaskHistoryEmb2 -> Section3.Decoder: "" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }

# 3 -> 4 (Grounded Parameters)
Section2.InterpretableEmbeddings.TheoryBases -> Section4.TheoryBase: "" { style: { stroke: "#229954"; stroke-width: 4; font-size: 80 } }
Section2.InterpretableEmbeddings.SemanticAxes -> Section4.SemanticProjection: "K,V axes" { style: { stroke: "#229954"; stroke-width: 4; font-size: 80 } }
Section3.ContextVector -> Section4.SemanticProjection: "z" { style: { stroke: "#000000"; stroke-width: 4; font-size: 80 } }

# 4 -> 5 (Outputs)
Section4.FinalParams -> Section5.Outputs.ReferenceOut: "p_L₀, p_T" { style: { stroke: "#229954"; stroke-width: 4; font-size: 80 } }
Section3.ContextVector -> Section5.Outputs.SupervisedOut: "" { style: { stroke: "#2874A6"; stroke-width: 4; font-size: 80 } }
Section3.ContextVector -> Section5.Outputs.DiagnosticProbes: "" { style: { stroke: "#229954"; stroke-width: 4; font-size: 80 } }

# Ground Truth -> Loss
Section1.InputData -> Section5.Loss.LossSup: "y" {
  style: {
    font-size: 80
    stroke: "#000000"
    stroke-width: 4
  }
}
Section1.BKT -> Section5.Loss.LossProbe: "BKT targets" {
  style: {
    font-size: 80
    stroke: "#229954"
    stroke-width: 4
  }
}

}

