direction: up

** {
  style: {
    font-size: 85
  }
}

MainContainer: {
  label: "Model Architecture"
  style: {
    stroke: "#333333"
    stroke-width: 3
    fill: "#ffffff"
    border-radius: 12
    font-size: 100
  }

# ============================================================================
# 1: INPUT COMPONENTS
# ============================================================================

Section1: {
  label: "1: Input Components"
  style: {
    stroke: "#333333"
    stroke-width: 3
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  BKT: {
    label: |md

      Reference Model

      BKT

      p<sub>L₀</sub>, p<sub>T</sub>
    |
    shape: cylinder
    style: {
      fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      shadow: true
    }
  }


  InputData: {
    label: |md
      Interaction 
      
      Data

      {(q, c, r, p<sub>L₀</sub>, p<sub>T</sub>)}
    |
    shape: cylinder
    style: {
      fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      shadow: true
    }
  }

}

# ============================================================================
# 2: EMBEDDINGS LAYER
# ============================================================================

Section2: {
  label: "2: Embeddings Layer"
  style: {
    stroke: "#333333"
    stroke-width: 3
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  TaskHistoryEmb: {
    label: |md
      History Embeddings
      (Response + Difficulty)
      
      y'<sub>t</sub> = e + u·f [Response + Difficulty]
      
      <span style="color:#666">e, f: [d]</span>

      <span style="color:#666">y': [d]</span>

      <span style="color:#666">u: scalar</span>

      <span style="color:#666">[B, S, d]</span>
    |
    shape: rectangle
    style: {
      fill: "#e8f4f8"
      stroke: "#333333"
      stroke-width: 3
      3d: true
      shadow: true
    }
  }
  
  TaskHistoryEmb2: {
    label: |md
      Task Embeddings
      (Standard + Difficulty)
      
      x'<sub>t</sub> = c + u·d [Concept + Difficulty]
      
      <span style="color:#666">c, d: [d]</span>

      <span style="color:#666">x': [d]</span>

      <span style="color:#666">u: scalar</span>

      <span style="color:#666">[B, S, d]</span>
    |
    shape: rectangle
    style: {
      fill: "#e8f4f8"
      stroke: "#333333"
      stroke-width: 3
      3d: true
      shadow: true
    }
  }
  
}

# ============================================================================
# 3: TRANSFORMER ARCHITECTURE
# ============================================================================

Section3: {
  label: "3: Transformer Architecture"
  style: {
    stroke: "#333333"
    stroke-width: 3
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  Encoder: {
    label: |md
      Encoder

      (Self-Attention)

      y'<sub>1:t-1</sub>
      
      <span style="color:#666">[B, S, d]</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      multiple: true
      shadow: true
    }
  }
  
  Decoder: {
    label: |md
      Decoder

      (Cross-Attention)

      x'<sub>t</sub>
      
      <span style="color:#666">[B, S, d]</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      multiple: true
      shadow: true
    }
  }
  
  ContextVector: {
    label: |md
      Context Vector

      z<sub>t</sub> = d<sub>out</sub> ⊕ q<sub>emb</sub>

      (High-dim Latent)
      
      <span style="color:#666">[B, S, z]</span>

      <span style="color:#666">z = d + e</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      shadow: true
    }
  }
  
  Encoder -> Decoder: "History Context" { style: { stroke: "#333333"; font-size: 80 } }
  Decoder -> ContextVector { style: { stroke: "#333333" } }
}

# ============================================================================
# 4: GROUNDED PARAMETERS (THREE-COMPONENT COMPOSITION)
# ============================================================================

Section4: {
  label: "4: Grounded Parameters (Additive Composition)"
  style: {
    stroke: "#333333"
    stroke-width: 3
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  TheoryBase: {
    label: |md
      Theory Base

      (Population Priors)
      
      ℓ<sub>L₀</sub> = σ⁻¹(μ<sub>L₀</sub>[q])

      ℓ<sub>T</sub> = σ⁻¹(μ<sub>T</sub>[q])
      
      <span style="color:#666">[B, S]</span>
    |
    shape: rectangle
    style: {
        fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      shadow: true
    }
  }
  
  ContextualProjection: {
    label: |md
      Contextual Projection

      (Linear Probes)
      
      Δ<sub>L₀</sub> = W<sub>L₀</sub> · z<sub>t</sub> + b<sub>L₀</sub>

      Δ<sub>T</sub>  = W<sub>T</sub> · z<sub>t</sub> + b<sub>T</sub>
      
      <span style="color:#666">W: [z, 1], b: [1]</span>

      <span style="color:#666">Δ: [B, S]</span>
    |
    shape: rectangle
    style: {
        fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      shadow: true
    }
  }
  
  
  FinalParams: {
    label: |md
      Final Parameters

      (Sigmoid Activation)
      
      p<sub>L₀</sub> = σ(ℓ<sub>L₀</sub> + Δ<sub>L₀</sub>)

      p<sub>T</sub> = σ(ℓ<sub>T</sub> + Δ<sub>T</sub>)
      
      <span style="color:#666">[B, S]</span>
    |
    shape: rectangle
    style: {
      fill: "#d4e6f1"
      stroke: "#333333"
      stroke-width: 3
      shadow: true
    }
  }
  
  TheoryBase -> FinalParams: "+" { style: { stroke: "#333333"; font-size: 80 } }
  ContextualProjection -> FinalParams: "+" { style: { stroke: "#333333"; font-size: 80 } }
}

# ============================================================================
# 5: OUTPUTS & MULTI-OBJECTIVE LOSS
# ============================================================================

Section5: {
  label: "5: Outputs & Multi-Objective Loss"
  style: {
    stroke: "#333333"
    stroke-width: 3
    fill: "#ffffff"
    border-radius: 8
    font-size: 100
    stroke-dash: 5
  }
  
  Outputs: {
    label: "Output Heads"
    style: {
      stroke: "#333333"
      stroke-width: 3
      stroke-dash: 5
      fill: "#ffffff"
      font-size: 90
    }
    
    SupervisedOut: {
      label: |md
        Supervised Prediction
        
        ŷ<sub>t</sub> = MLP(z<sub>t</sub>)
        
        <span style="color:#666">[B, S]</span>
      |
      shape: rectangle
      style: {
          fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
    
    ReferenceOut: {
      label: |md
        Reference Output

        (BKT Logic)
        
        ŷ<sub>ref</sub> = BKT(p<sub>L₀</sub>, p<sub>T</sub>)
        
        <span style="color:#666">[B, S]</span>
      |
      shape: rectangle
      style: {
          fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
    
    DiagnosticProbes: {
      label: |md
        Diagnostic Probes

        (Latent Diagnostics)
        
        p̂<sub>L₀</sub> = Linear(z<sub>t</sub>)

        p̂<sub>T</sub>  = Linear(z<sub>t</sub>)
        
        <span style="color:#666">[B, S]</span>
      |
      shape: rectangle
      style: {
          fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
  }
  
  Loss: {
    label: "Multi-Objective Loss"
    style: {
      stroke: "#333333"
      stroke-width: 3
      stroke-dash: 5
      fill: "#ffffff"
      font-size: 90
    }
    
    LossSup: {
      label: |md
        ℒ<sub>sup</sub>
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle
      style: {
        fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
    
    LossRef: {
      label: |md
        ℒ<sub>ref</sub>
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle
      style: {
        fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
    
    LossProbe: {
      label: |md
        ℒ<sub>probe</sub>

        (Probe Alignment)
        
        MSE(p̂<sub>L₀</sub>, μ<sub>L₀</sub>) + MSE(p̂<sub>T</sub>, μ<sub>T</sub>)
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle  
      style: {
        fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
    
    TotalLoss: {
      label: |md
        Total Loss
        
        ℒ = λ<sub>sup</sub>·ℒ<sub>sup</sub> + λ<sub>ref</sub>·ℒ<sub>ref</sub> + λ<sub>probe</sub>·ℒ<sub>probe</sub>
        
        <span style="color:#666">Scalar</span>
      |
      shape: rectangle
      style: {
        fill: "#d4e6f1"
        stroke: "#333333"
        stroke-width: 3
        shadow: true
      }
    }
    
    LossSup -> TotalLoss: "" { style: { stroke: "#333333"; font-size: 80 } }
    LossRef -> TotalLoss: "" { style: { stroke: "#333333"; font-size: 80 } }
    LossProbe -> TotalLoss: "" { style: { stroke: "#333333"; font-size: 80 } }
  }
  
  Outputs.SupervisedOut -> Loss.LossSup { style: { stroke: "#333333" } }
  Outputs.ReferenceOut -> Loss.LossRef { style: { stroke: "#333333" } }
  Outputs.DiagnosticProbes -> Loss.LossProbe { style: { stroke: "#333333" } }
}

# ============================================================================
# DATA FLOW CONNECTIONS BETWEEN SECTIONS
# ============================================================================

# 1 -> 2
Section1.BKT -> Section1.InputData: "" { style: { stroke: "#333333"; font-size: 80 } }
Section1.InputData -> Section2.TaskHistoryEmb: "" { style: { stroke: "#333333"; font-size: 80 } }

# 2 -> 3
Section2.TaskHistoryEmb -> Section3.Encoder: "" { style: { stroke: "#333333"; font-size: 80 } }
Section2.TaskHistoryEmb2 -> Section3.Decoder: "" { style: { stroke: "#333333"; font-size: 80 } }

# 3 -> 4
Section1.BKT -> Section4.TheoryBase: "" { style: { stroke: "#333333"; font-size: 80 } }
Section3.ContextVector -> Section4.ContextualProjection: "" { style: { stroke: "#333333"; font-size: 80 } }

# 4 -> 5
Section4.FinalParams -> Section5.Outputs.ReferenceOut: "" { style: { stroke: "#333333"; font-size: 80 } }
Section3.ContextVector -> Section5.Outputs.SupervisedOut: "" { style: { stroke: "#333333"; font-size: 80 } }
Section3.ContextVector -> Section5.Outputs.DiagnosticProbes: "" { style: { stroke: "#333333"; font-size: 80 } }

# Ground Truth -> Loss
Section1.InputData -> Section5.Loss.LossSup: "y" {
  style: {
    stroke-dash: 5
    opacity: 0.5
    font-size: 80
    stroke: "#333333"
  }
}
Section1.BKT -> Section5.Loss.LossProbe: "" {
  style: {
    stroke-dash: 5
    opacity: 0.5
    font-size: 80
    stroke: "#333333"
  }
}

}

