# Loss Layer
LossLayer: {
  label: Total Loss (ℒ)
  style: {
    stroke: "#000000"
    stroke-width: 3
    stroke-dash: 5
    fill: "#ffffff"
  }
  
  LossSup: {
    label: |md
      ℒ_sup
      (Supervised)
    |
    shape: circle
    style: {
      fill: "#f8d7da"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  
  LossRef: {
    label: |md
      ℒ_ref
      (Reference)
    |
    shape: circle
    style: {
      fill: "#f8d7da"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  
  LossProbe: {
    label: |md
      ℒ_probe
      (Probing)
    |
    shape: circle
    style: {
      fill: "#f8d7da"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  
  TotalLoss: {
    label: |md
      **Total Loss**
      
      ℒ = λ_sup·ℒ_sup +
          λ_ref·ℒ_ref +
          λ_probe·ℒ_probe
    |
    shape: rectangle
    style: {
      fill: "#ffcccc"
      stroke: "#000000"
      stroke-width: 3
    }
  }
  
  LossSup -> TotalLoss: "λ_sup"
  LossRef -> TotalLoss: "λ_ref"
  LossProbe -> TotalLoss: "λ_probe"
}

# Ground Truth
GroundTruth: {
  label: |md
    Ground Truth
    y_true
  |
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

Oracle: {
  label: |md
    Oracle Targets
    (BKT Labels)
  |
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

# Connections: Inputs to Outputs
ContextVector -> Outputs.SupervisedOut: "Direct MLP"
ContextVector -> Outputs.DiagnosticProbes: "Linear Probe"
FinalParams -> Outputs.ReferenceOut: "p_L0, p_T"

# Connections: Outputs to Loss
Outputs.SupervisedOut -> LossLayer.LossSup
Outputs.ReferenceOut -> LossLayer.LossRef
Outputs.DiagnosticProbes -> LossLayer.LossProbe

# Connections: Ground Truth to Loss
GroundTruth -> LossLayer.LossSup: "y_true"
GroundTruth -> LossLayer.LossRef: "y_true"
Oracle -> LossLayer.LossProbe: "Oracle p_L0, p_T"

# Info Box
Info: {
  shape: rectangle
