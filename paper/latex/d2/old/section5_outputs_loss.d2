    label: |md
      **Reference Output**
      (BKT Logic)
      
      ŷ_ref = BKT(p_L0, p_T)
    |
    shape: rectangle
    style: {
      fill: "#d5f4e6"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  
  DiagnosticProbes: {
    label: |md
      **Diagnostic Probes**
      (Active Grounding)
      
      Probe_L0(zₜ)
      Probe_T(zₜ)
