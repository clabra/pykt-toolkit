\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Accuracy--Interpretability trade-off across datasets with gTransformer. The table shows AUC scores for the predictions of the ablated configuration ($p_{\text  {sup}1}$), predictions of the grounded configuration ($p_{\text  {sup}2}$), interpretable predictions ($p_{\text  {ref}}$), and classical BKT predictions ($p_{\text  {bkt}}$). \textit  {Int. Drop} measures the representational cost of grounding ($p_{\text  {sup}1} - p_{\text  {sup}2}$), \textit  {Int. Cost} measures total interpretability cost ($p_{\text  {sup}1} - p_{\text  {ref}}$), while \textit  {Int. Gain} measures ($p_{\text  {ref}} - p_{\text  {bkt}}$).\relax }}{14}{table.caption.5}\protected@file@percent }
\newlabel{tab:tradeoff}{{3}{14}{Accuracy--Interpretability trade-off across datasets with gTransformer. The table shows AUC scores for the predictions of the ablated configuration ($p_{\text {sup}1}$), predictions of the grounded configuration ($p_{\text {sup}2}$), interpretable predictions ($p_{\text {ref}}$), and classical BKT predictions ($p_{\text {bkt}}$). \textit {Int. Drop} measures the representational cost of grounding ($p_{\text {sup}1} - p_{\text {sup}2}$), \textit {Int. Cost} measures total interpretability cost ($p_{\text {sup}1} - p_{\text {ref}}$), while \textit {Int. Gain} measures ($p_{\text {ref}} - p_{\text {bkt}}$).\relax }{table.caption.5}{}}
\newlabel{tab:tradeoff@cref}{{[table][3][]3}{[1][14][]14}}
