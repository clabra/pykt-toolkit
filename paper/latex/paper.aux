\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Context-aware skill mosaic showing non-Markovian personalization. Each panel displays students with identical response sequences (same ground truth bars) but different learning profiles (quadrants). BKT predictions (dotted gray) overlap due to Markovian constraints, while gTransformer predictions (solid colored) diverge based on historical learning parameters ($P_{L_0}$, $P_T$). This demonstrates that gTransformer differentiates students not by \textit  {what they answered}, but by \textit  {how they learned}.\relax }}{23}{figure.caption.12}\protected@file@percent }
\newlabel{fig:skill_quadrant_mosaic}{{9}{23}{Context-aware skill mosaic showing non-Markovian personalization. Each panel displays students with identical response sequences (same ground truth bars) but different learning profiles (quadrants). BKT predictions (dotted gray) overlap due to Markovian constraints, while gTransformer predictions (solid colored) diverge based on historical learning parameters ($P_{L_0}$, $P_T$). This demonstrates that gTransformer differentiates students not by \textit {what they answered}, but by \textit {how they learned}.\relax }{figure.caption.12}{}}
