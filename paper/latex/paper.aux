\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Context-aware prediction mosaic showing non-Markovian \replaced [id=rev]{personalisation}{personalization}. Each panel displays students with identical response sequences (same ground truth bars) but different learning profiles. BKT predictions (dotted \replaced [id=rev]{grey}{gray}) overlap due to Markovian constraints, while gTransformer predictions (solid \replaced [id=rev]{coloured}{colored}) diverge based on historical parameters ($P_{L_0}, P_T$). Circles represent predictions of correctness, while crosses indicate predicted failures. This demonstrates that gTransformer differentiates students not by what they answered, but by how they learned along their whole learning trajectory.\relax }}{23}{figure.caption.11}\protected@file@percent }
\@writefile{loc}{\ChangesListline {replaced}{Replaced\nobreakspace  {}(rev)}{personalisation}{23}}
\@writefile{loc}{\ChangesListline {replaced}{Replaced\nobreakspace  {}(rev)}{grey}{23}}
\@writefile{loc}{\ChangesListline {replaced}{Replaced\nobreakspace  {}(rev)}{coloured}{23}}
\newlabel{fig:skill_quadrant_mosaic}{{9}{23}{Context-aware prediction mosaic showing non-Markovian \replaced [id=rev]{personalisation}{personalization}. Each panel displays students with identical response sequences (same ground truth bars) but different learning profiles. BKT predictions (dotted \replaced [id=rev]{grey}{gray}) overlap due to Markovian constraints, while gTransformer predictions (solid \replaced [id=rev]{coloured}{colored}) diverge based on historical parameters ($P_{L_0}, P_T$). Circles represent predictions of correctness, while crosses indicate predicted failures. This demonstrates that gTransformer differentiates students not by what they answered, but by how they learned along their whole learning trajectory.\relax }{figure.caption.11}{}}
\newlabel{fig:skill_quadrant_mosaic@cref}{{[figure][9][]9}{[1][22][]23}}
