\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The iDKT Architecture. The diagram illustrates the complete pipeline: (1) \textbf  {Input Layer} with BKT reference data, (2) \textbf  {Representational Grounding} where input embeddings incorporate personalized initial knowledge ($l_c$) and learning rate ($t_c$) derived from BKT parameters, (3) \textbf  {Encoder-Decoder Transformer} processing interaction history and tasks, (4) \textbf  {Prediction} via concatenated representations and MLP, (5) \textbf  {Multi-objective Loss Functions} for grounding, and (6) \textbf  {Diagnostic Probing Validation} that validates preservation of pedagogical constructs through linear probes with control tasks.\relax }}{6}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{idkt_arch}{{1}{6}{The iDKT Architecture. The diagram illustrates the complete pipeline: (1) \textbf {Input Layer} with BKT reference data, (2) \textbf {Representational Grounding} where input embeddings incorporate personalized initial knowledge ($l_c$) and learning rate ($t_c$) derived from BKT parameters, (3) \textbf {Encoder-Decoder Transformer} processing interaction history and tasks, (4) \textbf {Prediction} via concatenated representations and MLP, (5) \textbf {Multi-objective Loss Functions} for grounding, and (6) \textbf {Diagnostic Probing Validation} that validates preservation of pedagogical constructs through linear probes with control tasks.\relax }{figure.caption.1}{}}
