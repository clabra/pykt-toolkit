\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Structural Fidelity for Initial Mastery $P_{L_0}$. Plot showing strong linear recoverability ($R^2=0.549$, $r=0.743$, $\Delta =0.619$) between BKT theoretical priors and probe-extracted parameters. Each bubble represents a binned aggregate of test interactions, with size encoding sample density. The tight adherence to the diagonal and high selectivity ($\Delta > 0.5$) validate that $P_{L_0}$ is a dominant organizing principle in latent representations. \relax }}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig_structural_fidelity_l0}{{3}{18}{Structural Fidelity for Initial Mastery $P_{L_0}$. Plot showing strong linear recoverability ($R^2=0.549$, $r=0.743$, $\Delta =0.619$) between BKT theoretical priors and probe-extracted parameters. Each bubble represents a binned aggregate of test interactions, with size encoding sample density. The tight adherence to the diagonal and high selectivity ($\Delta > 0.5$) validate that $P_{L_0}$ is a dominant organizing principle in latent representations. \relax }{figure.caption.7}{}}
\newlabel{fig_structural_fidelity_l0@cref}{{[figure][3][]3}{[1][17][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Structural Fidelity for Learning Rate $P_T$. Plot demonstrating robust linear recoverability ($R^2=0.515$, $r=0.721$, $\Delta =0.570$) between BKT theoretical priors and probe-extracted parameters. The tight clustering around the diagonal and high selectivity ($\Delta > 0.5$) confirm that learning rate dynamics are dominantly encoded in latent representations. \relax }}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig_structural_fidelity_t}{{4}{18}{Structural Fidelity for Learning Rate $P_T$. Plot demonstrating robust linear recoverability ($R^2=0.515$, $r=0.721$, $\Delta =0.570$) between BKT theoretical priors and probe-extracted parameters. The tight clustering around the diagonal and high selectivity ($\Delta > 0.5$) confirm that learning rate dynamics are dominantly encoded in latent representations. \relax }{figure.caption.7}{}}
\newlabel{fig_structural_fidelity_t@cref}{{[figure][4][]4}{[1][17][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Semantic Alignment for Initial Mastery $P(L_0)$. Plot showing weak monotonic relationship preservation (Spearman $\rho = 0.360$, MAE = $0.168$) between BKT theoretical priors and grounded parameters after neural transformation. Each bubble represents an aggregate of test interactions, with size encoding sample density. The substantial scatter indicates strong student-specific individualization, with the model prioritizing context-aware adaptation over strict adherence to population priors. \relax }}{19}{figure.caption.8}\protected@file@percent }
\newlabel{fig_semantic_alignment_l0}{{5}{19}{Semantic Alignment for Initial Mastery $P(L_0)$. Plot showing weak monotonic relationship preservation (Spearman $\rho = 0.360$, MAE = $0.168$) between BKT theoretical priors and grounded parameters after neural transformation. Each bubble represents an aggregate of test interactions, with size encoding sample density. The substantial scatter indicates strong student-specific individualization, with the model prioritizing context-aware adaptation over strict adherence to population priors. \relax }{figure.caption.8}{}}
\newlabel{fig_semantic_alignment_l0@cref}{{[figure][5][]5}{[1][17][]19}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Semantic Alignment for Learning Rate $P(T)$. Plot demonstrating moderate monotonic relationship preservation (Spearman $\rho = 0.544$, MAE = $0.092$) between BKT theoretical priors and grounded parameters. The clustering around the diagonal across the full $P_T$ range indicates the model preserves pedagogical understanding of practice effects through neural processing while enabling context-aware refinement. \relax }}{19}{figure.caption.8}\protected@file@percent }
\newlabel{fig_semantic_alignment_t}{{6}{19}{Semantic Alignment for Learning Rate $P(T)$. Plot demonstrating moderate monotonic relationship preservation (Spearman $\rho = 0.544$, MAE = $0.092$) between BKT theoretical priors and grounded parameters. The clustering around the diagonal across the full $P_T$ range indicates the model preserves pedagogical understanding of practice effects through neural processing while enabling context-aware refinement. \relax }{figure.caption.8}{}}
\newlabel{fig_semantic_alignment_t@cref}{{[figure][6][]6}{[1][17][]19}}
