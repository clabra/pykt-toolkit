\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Functional layers of the gTransformer Architecture (blue components denote standard Transformer elements; green components denote gTransformer-specific theoretical grounding): (1) \textit  {Input Components}: student interaction data enriched with BKT reference parameters; (2) \textit  {Difficulty-Aware Embeddings}: task-specific embeddings ($x'$) composed of concept bases and difficulty variations, and interaction history embeddings ($y'$) encoding prior responses; (3) \textit  {Attention-based Encoder-Decoder}: a stacked Transformer architecture with $n$ encoder blocks (self-attention on interaction history) and $2n$ decoder blocks (alternating self-attention on current questions and cross-attention with encoded history), producing a high-dimensional context vector $z_t$ by concatenating the final decoder output $d_{out}$ with question embeddings; (4) \textit  {Grounded Parameters}: additive composition of BKT-initialized theoretical bases ($\ell _{L_0}, \ell _T$) and contextual projections ($\Delta _{L_0}, \Delta _T$) computed via dot products of $z_t$ with learnable semantic axes ($K_{axis}, V_{axis}$), yielding pedagogically-grounded parameters ($p_{L_0}, p_T$); (5) \textit  {Output Heads}: supervised prediction ($\hat  {y}_{sup}$) from an MLP applied to $z_t$, interpretable prediction ($\hat  {y}_{ref}$) generated by feeding enriched parameters (projected from $z_t$) through BKT logic to preserve causal explainability (Reference Output), and linear probes ($\hat  {p}_{L_0}, \hat  {p}_T$) for internal representation analysis; finally (6) \textit  {Multi-Objective Loss}: weighted combination of supervised loss ($\mathcal  {L}_{sup}$), reference output loss ($\mathcal  {L}_{ref}$), and probing loss ($\mathcal  {L}_{probe}$) for aligning neural representations with pedagogical theory.\relax }}{9}{figure.caption.2}\protected@file@percent }
\newlabel{gtransformer_arch}{{2}{9}{Functional layers of the gTransformer Architecture (blue components denote standard Transformer elements; green components denote gTransformer-specific theoretical grounding): (1) \textit {Input Components}: student interaction data enriched with BKT reference parameters; (2) \textit {Difficulty-Aware Embeddings}: task-specific embeddings ($x'$) composed of concept bases and difficulty variations, and interaction history embeddings ($y'$) encoding prior responses; (3) \textit {Attention-based Encoder-Decoder}: a stacked Transformer architecture with $n$ encoder blocks (self-attention on interaction history) and $2n$ decoder blocks (alternating self-attention on current questions and cross-attention with encoded history), producing a high-dimensional context vector $z_t$ by concatenating the final decoder output $d_{out}$ with question embeddings; (4) \textit {Grounded Parameters}: additive composition of BKT-initialized theoretical bases ($\ell _{L_0}, \ell _T$) and contextual projections ($\Delta _{L_0}, \Delta _T$) computed via dot products of $z_t$ with learnable semantic axes ($K_{axis}, V_{axis}$), yielding pedagogically-grounded parameters ($p_{L_0}, p_T$); (5) \textit {Output Heads}: supervised prediction ($\hat {y}_{sup}$) from an MLP applied to $z_t$, interpretable prediction ($\hat {y}_{ref}$) generated by feeding enriched parameters (projected from $z_t$) through BKT logic to preserve causal explainability (Reference Output), and linear probes ($\hat {p}_{L_0}, \hat {p}_T$) for internal representation analysis; finally (6) \textit {Multi-Objective Loss}: weighted combination of supervised loss ($\mathcal {L}_{sup}$), reference output loss ($\mathcal {L}_{ref}$), and probing loss ($\mathcal {L}_{probe}$) for aligning neural representations with pedagogical theory.\relax }{figure.caption.2}{}}
\newlabel{gtransformer_arch@cref}{{[figure][2][]2}{[1][8][]9}}
