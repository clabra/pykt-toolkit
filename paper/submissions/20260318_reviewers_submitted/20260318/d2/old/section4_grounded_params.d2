direction: down

title: "Section 4: Grounded Parameters (Three-Component Composition)" {
  near: top-center
  shape: text
  style: {
    font-size: 24
    bold: true
  }
}

# Inputs
ContextVector: {
  label: |md
    Context Vector
    zₜ
  |
  shape: hexagon
  style: {
    fill: "#aed6f1"
    stroke: "#000000"
    stroke-width: 2
  }
}

StudentEmbeddings: {
  label: |md
    Student
    Embeddings
  |
  shape: rectangle
  style: {
    fill: "#fff8e8"
    stroke: "#ff8800"
    stroke-width: 2
    stroke-dash: 3
  }
}

BKT: {
  label: BKT Priors
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

# Grounded Parameters Layer
GroundedParams: {
  label: Grounded Parameters
  style: {
    stroke: "#000000"
    stroke-width: 3
    fill: "#ffffff"
  }
  
  TheoryBase: {
    label: |md
      **Theory Base**
      (Always Active)
      
      p_L0_base[q]
      p_T_base[q]
    |
    shape: rectangle
    style: {
      fill: "#d5f4e6"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  
  ContextualProjection: {
    label: |md
      **Contextual Projection**
      (Always Active)
      
      z · k_axis[q]
      z · v_axis[q]
    |
    shape: rectangle
    style: {
      fill: "#d5f4e6"
      stroke: "#000000"
      stroke-width: 2
    }
  }
  
  StudentMemory: {
    label: |md
      **Student Memory**
      (if personalization=true)
      
      s_gap[uid]
      s_vel[uid]
    |
    shape: rectangle
    style: {
      fill: "#fff8e8"
      stroke: "#ff8800"
      stroke-width: 2
      stroke-dash: 3
    }
  }
  
  FinalParams: {
    label: |md
      **Final Parameters**
      
      p_L0 = σ(Base + Context + Student)
      p_T = σ(Base + Context + Student)
    |
    shape: rectangle
    style: {
      fill: "#fdebd0"
      stroke: "#000000"
      stroke-width: 3
    }
  }
  
  TheoryBase -> FinalParams: "+" {
    style: {
      stroke-width: 2
    }
  }
  ContextualProjection -> FinalParams: "+" {
    style: {
      stroke-width: 2
    }
  }
  StudentMemory -> FinalParams: "+ (if enabled)" {
    style: {
      stroke-width: 2
      stroke-dash: 3
      stroke: "#ff8800"
    }
  }
}

# Connections
BKT -> GroundedParams.TheoryBase: "Population Priors"
ContextVector -> GroundedParams.TheoryBase: "Skill Context"
ContextVector -> GroundedParams.ContextualProjection: "z · Axis"
StudentEmbeddings -> GroundedParams.StudentMemory: "Biases" {
  style: {
    stroke-dash: 3
    stroke: "#ff8800"
  }
}

# Output
ReferenceOutput: {
  label: |md
    Reference Output
    (BKT Logic)
  |
  shape: rectangle
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

GroundedParams.FinalParams -> ReferenceOutput: "p_L0, p_T"

# Legend
Formula: {
  shape: rectangle
  label: |md
    **Additive Composition:**
    
    Baseline Mode (personalization=false):
    p_L0 = σ(Theory_Base + Contextual_Projection)
    
    Hybrid Mode (personalization=true):
    p_L0 = σ(Theory_Base + Contextual_Projection + Student_Memory)
  |
  style: {
    fill: "#f9f9f9"
    stroke: "#666666"
    stroke-width: 1
  }
}
