\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \hl {Structural} fidelity for Initial Mastery $P(\text  {L}_0)$. Plot demonstrating strong linear recoverability ($R^2=0.549$, $r=0.743$, $\Delta R^2=0.619$) between BKT theoretical priors and probe-extracted parameters. Each bubble represents a binned aggregate of test interactions, with\nobreakspace  {}size encoding sample density. The\nobreakspace  {}high adherence to the diagonal and high selectivity ($\Delta R^2>0.5$) validate that this is a dominant organising principle in latent\nobreakspace  {}representations. \relax }}{18}{figure.caption.7}\protected@file@percent }
\newlabel{fig_structural_fidelity_l0}{{3}{18}{\protect \hl {Structural} fidelity for Initial Mastery $P(\text {L}_0)$. Plot demonstrating strong linear recoverability ($R^2=0.549$, $r=0.743$, $\Delta R^2=0.619$) between BKT theoretical priors and probe-extracted parameters. Each bubble represents a binned aggregate of test interactions, with~size encoding sample density. The~high adherence to the diagonal and high selectivity ($\Delta R^2>0.5$) validate that this is a dominant organising principle in latent~representations. \relax }{figure.caption.7}{}}
\newlabel{fig_structural_fidelity_l0@cref}{{[figure][3][]3}{[1][17][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \hl {Structural} fidelity for Learn Rate $P(\text  {T})$. Plot demonstrating robust linear recoverability ($R^2=0.515$, $r=0.721$, $\Delta R^2=0.570$) between BKT theoretical priors and probe-extracted parameters. The\nobreakspace  {}high adherence to the diagonal and high selectivity ($\Delta R^2>0.5$) confirm that learn rate dynamics are dominantly encoded in latent\nobreakspace  {}representations. \relax }}{18}{figure.caption.8}\protected@file@percent }
\newlabel{fig_structural_fidelity_t}{{4}{18}{\protect \hl {Structural} fidelity for Learn Rate $P(\text {T})$. Plot demonstrating robust linear recoverability ($R^2=0.515$, $r=0.721$, $\Delta R^2=0.570$) between BKT theoretical priors and probe-extracted parameters. The~high adherence to the diagonal and high selectivity ($\Delta R^2>0.5$) confirm that learn rate dynamics are dominantly encoded in latent~representations. \relax }{figure.caption.8}{}}
\newlabel{fig_structural_fidelity_t@cref}{{[figure][4][]4}{[1][17][]18}}
