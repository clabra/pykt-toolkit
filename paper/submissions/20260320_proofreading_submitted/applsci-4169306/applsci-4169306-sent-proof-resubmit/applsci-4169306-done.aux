\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \hl {Semantic} alignment for Initial Mastery \texthl  {$p_{\text  {L}_0}$}. Plot showing weak monotonic relationship preservation (Spearman $\rho = 0.360$, Mean Absolute Error (MAE) = $0.168$) between BKT theoretical priors and grounded parameters after neural transformation. Each bubble represents an aggregate of test interactions, with\nobreakspace  {}size encoding sample density. The\nobreakspace  {}substantial scatter indicates strong student-specific individualisation, with\nobreakspace  {}the model prioritising context-aware adaptation over strict adherence to population\nobreakspace  {}priors. \relax }}{20}{figure.caption.9}\protected@file@percent }
\newlabel{fig_semantic_alignment_l0}{{5}{20}{\protect \hl {Semantic} alignment for Initial Mastery \hl {$p_{\text {L}_0}$}. Plot showing weak monotonic relationship preservation (Spearman $\rho = 0.360$, Mean Absolute Error (MAE) = $0.168$) between BKT theoretical priors and grounded parameters after neural transformation. Each bubble represents an aggregate of test interactions, with~size encoding sample density. The~substantial scatter indicates strong student-specific individualisation, with~the model prioritising context-aware adaptation over strict adherence to population~priors. \relax }{figure.caption.9}{}}
\newlabel{fig_semantic_alignment_l0@cref}{{[figure][5][]5}{[1][19][]20}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \hl {Semantic} alignment for Learn Rate \texthl  {$p_{\text  {T}}$}. Plot demonstrating moderate monotonic relationship preservation (Spearman $\rho = 0.544$, MAE = $0.092$) between BKT theoretical priors and grounded parameters. Each bubble represents an aggregate of test interactions, with\nobreakspace  {}size encoding sample density. The\nobreakspace  {}clustering around the diagonal across the full $P_{\text  {T}}$ range indicates that the model preserves pedagogical understanding of practice effects through neural processing while enabling context-aware\nobreakspace  {}refinement. \relax }}{20}{figure.caption.9}\protected@file@percent }
\newlabel{fig_semantic_alignment_t}{{6}{20}{\protect \hl {Semantic} alignment for Learn Rate \hl {$p_{\text {T}}$}. Plot demonstrating moderate monotonic relationship preservation (Spearman $\rho = 0.544$, MAE = $0.092$) between BKT theoretical priors and grounded parameters. Each bubble represents an aggregate of test interactions, with~size encoding sample density. The~clustering around the diagonal across the full $P_{\text {T}}$ range indicates that the model preserves pedagogical understanding of practice effects through neural processing while enabling context-aware~refinement. \relax }{figure.caption.9}{}}
