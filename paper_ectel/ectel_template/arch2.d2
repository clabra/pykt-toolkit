# Simplified gTransformer architecture for ECTEL 2026
# Unified container layout using GRID layout to force horizontal alignment
# Synchronized with arch3.d2: dark gray labels, larger font sizes, professional notation

direction: right

classes: {
  track: {
    style: {
      stroke: "#333333"
      stroke-width: 2
      shadow: true
      border-radius: 8
      font-size: 22
      text-transform: uppercase
      fill: "white"
      bold: true
    }
  }
}

Architecture: {
  label: "Grounded Transformer System"
  style: {
    stroke: "#E5E5E5"
    stroke-width: 1
    fill: "white"
    border-radius: 16
    font-size: 22
    bold: true
  }

  # Aggressively increase grid spacing
  grid-columns: 3
  horizontal-gap: 150

  # Section 1: Input (Left)
  Input: {
    style: {
      stroke: "#333333"
      stroke-width: 1
      stroke-dash: 4
      fill: "white"
      border-radius: 12
    }
    direction: down
    vertical-gap: 120

    Interactions: "Interaction History\n(q, c, r)" {
      shape: cylinder
      style: {
        fill: "white"
        stroke: "#333333"
        stroke-width: 2
        shadow: true
        font-size: 18
      }
    }

    # Dummy edge to force BKT under Interactions
    Interactions -> BKT: { style.stroke: "white" }

    BKT: "BKT Reference Model\n(Theory Anchor)" {
      style: {
        fill: "white"
        stroke: "#333333"
        stroke-width: 2
        shadow: true
        font-size: 18
      }
    }
  }

  # Section 2: gTransformer (Middle)
  gTransformer: {
    label: "gTransformer model"
    style: {
      stroke: "#333333"
      stroke-width: 2
      fill: "#FDFDFD"
      border-radius: 12
      shadow: true
      font-size: 22
      bold: true
    }
    direction: down
    vertical-gap: 120

    StandardTrack: "Standard Track" {
      class: track
    }

    GroundedTrack: "Grounded Track" {
      class: track
    }

    Loss: "Multi-objective Loss\n(Accuracy + Grounding)" {
      class: track
      style: {
        text-transform: none
        font-size: 20
      }
    }

    # Internal connections
    StandardTrack -> GroundedTrack: "Context Vector z_t" { 
      style: { 
        stroke: "#333333"
        stroke-width: 2
        font-color: "#555555"
        font-size: 18
        bold: true
      }
    }
    StandardTrack -> Loss: "ŷₜ predictions" { 
      style: { 
        stroke: "#333333"
        stroke-width: 2
        font-color: "#555555"
        font-size: 18
        bold: true
      }
    }
    GroundedTrack -> Loss: "ŷ_ref predictions" { 
      style: { 
        stroke: "#333333"
        stroke-width: 2
        font-color: "#555555"
        font-size: 18
        bold: true
      }
    }
  }

  # Section 3: Output (Right)
  Output: {
    style: {
      stroke: "#333333"
      stroke-width: 1
      stroke-dash: 4
      fill: "white"
      border-radius: 12
    }
    direction: down
    vertical-gap: 120

    Indicators: "Grounded Parameters\n(p_L₀, p_ₜ)" {
      shape: cylinder
      style: {
        fill: "white"
        stroke: "#333333"
        stroke-width: 2
        shadow: true
        font-size: 18
      }
    }
  }
}

# Connections outside the grid to avoid disrupting the 1-2-3 cell layout
Architecture.Input.Interactions -> Architecture.gTransformer.StandardTrack: { 
  style: { 
    stroke: "#333333"
    stroke-width: 2
  }
}
Architecture.Input.BKT -> Architecture.gTransformer.GroundedTrack: "(L₀, T) priors" { 
  style: { 
    stroke: "#333333"
    stroke-width: 2
    font-color: "#555555"
    font-size: 18
    bold: true
  }
}
Architecture.gTransformer.GroundedTrack -> Architecture.Output.Indicators: "(p_L₀, p_ₜ)" { 
  style: { 
    stroke: "#333333"
    stroke-width: 2
    font-color: "#555555"
    font-size: 18
    bold: true
  }
}
