\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Context-aware prediction mosaic.} Each panel shows students with identical response sequences (green/red bars for correct/incorrect responses) but different learning situations. BKT predictions (dotted grey) overlap due to Markovian constraints; gTransformer predictions (solid coloured) diverge based on historical parameters ($p_{\text  {L}_0}$, $p_{\text  {T}}$). Circles indicate predicted correct responses; crosses indicate predicted failures.}}{11}{figure.1.2}\protected@file@percent }
\newlabel{fig_mosaic}{{2}{11}{\textbf {Context-aware prediction mosaic.} Each panel shows students with identical response sequences (green/red bars for correct/incorrect responses) but different learning situations. BKT predictions (dotted grey) overlap due to Markovian constraints; gTransformer predictions (solid coloured) diverge based on historical parameters ($p_{\text {L}_0}$, $p_{\text {T}}$). Circles indicate predicted correct responses; crosses indicate predicted failures}{figure.1.2}{}}
