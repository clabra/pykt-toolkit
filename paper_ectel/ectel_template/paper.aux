\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Parameter orbit ellipses.} Covariance ellipses (1$\sigma $ and 2$\sigma $) for the representative student of each learning situation in $(p_{\text  {L}_0}, p_{\text  {T}})$ space. The centre marks the mean parameter position; ellipse shape encodes the extent and orientation of parameter variability across all interactions.\relax }}{14}{figure.caption.3}\protected@file@percent }
\newlabel{fig_ellipse}{{2}{14}{\textbf {Parameter orbit ellipses.} Covariance ellipses (1$\sigma $ and 2$\sigma $) for the representative student of each learning situation in $(p_{\text {L}_0}, p_{\text {T}})$ space. The centre marks the mean parameter position; ellipse shape encodes the extent and orientation of parameter variability across all interactions.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Return maps.} Lag plots for the representative student of each learning situation. Each panel shows $p_{\text  {L}_0}(t+1)$ vs $p_{\text  {L}_0}(t)$ (left) and $p_{\text  {T}}(t+1)$ vs $p_{\text  {T}}(t)$ (right). Points are coloured from dark (early) to bright (late) interactions. The diagonal (dashed line) marks the fixed point; deviations above indicate increasing parameters and deviations below indicate decreasing ones.\relax }}{15}{figure.caption.4}\protected@file@percent }
\newlabel{fig_returnmap}{{3}{15}{\textbf {Return maps.} Lag plots for the representative student of each learning situation. Each panel shows $p_{\text {L}_0}(t+1)$ vs $p_{\text {L}_0}(t)$ (left) and $p_{\text {T}}(t+1)$ vs $p_{\text {T}}(t)$ (right). Points are coloured from dark (early) to bright (late) interactions. The diagonal (dashed line) marks the fixed point; deviations above indicate increasing parameters and deviations below indicate decreasing ones.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Context-aware prediction mosaic.} Each panel shows students with identical response sequences (green/red bars for correct/incorrect responses) but different learning situations. BKT predictions (dotted grey) overlap due to Markovian constraints; gTransformer predictions (solid coloured) diverge based on historical parameters ($p_{\text  {L}_0}$, $p_{\text  {T}}$). Circles indicate predicted correct responses; crosses indicate predicted failures.\relax }}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig_mosaic}{{4}{16}{\textbf {Context-aware prediction mosaic.} Each panel shows students with identical response sequences (green/red bars for correct/incorrect responses) but different learning situations. BKT predictions (dotted grey) overlap due to Markovian constraints; gTransformer predictions (solid coloured) diverge based on historical parameters ($p_{\text {L}_0}$, $p_{\text {T}}$). Circles indicate predicted correct responses; crosses indicate predicted failures.\relax }{figure.caption.10}{}}
