\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Learning situation trajectories.} Each plot traces the evolution of the parameter pair $(p_{\text  {T}}, p_{\text  {L}_0})$ for the representative student of one learning situation in the AS2009 dataset. Marker area encodes dwell time (interactions absorbed between two plotted points). The first and last arrows are rendered in a darker tone; all intermediate arrows are in light grey. The $p_{\text  {T}}$ axis is capped at 0.5. Coloured background regions delimit the four learning situations.\relax }}{12}{figure.caption.6}\protected@file@percent }
