direction: right

title: "Section 1: Input Components" {
  near: top-center
  shape: text
  style: {
    font-size: 24
    bold: true
  }
}

BKT: {
  label: |md
    BKT
    Reference Model
  |
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

Oracle: {
  label: |md
    Oracle
    Labels
  |
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

InputData: {
  label: |md
    Interaction
    Data
  |
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

StudentIDs: {
  label: |md
    Student IDs
    (if personalization=true)
  |
  shape: cylinder
  style: {
    fill: "#fff8e8"
    stroke: "#ff8800"
    stroke-width: 2
    stroke-dash: 3
  }
}

Legend: {
  shape: rectangle
  label: |md
    Legend:
    • Solid border = Always active
    • Dashed border = Conditional (personalization=true)
  |
  style: {
    fill: "#f0f0f0"
    stroke: "#666666"
    stroke-width: 1
  }
}

BKT -> InputData: {style.opacity: 0}
Oracle -> InputData: {style.opacity: 0}
InputData -> StudentIDs: {style.opacity: 0}
