direction: down

title: "Section 2: Embeddings Layer" {
  near: top-center
  shape: text
  style: {
    font-size: 24
    bold: true
  }
}

EmbeddingsLayer: {
  label: Embeddings Layer
  style: {
    stroke: "#000000"
    stroke-width: 3
    stroke-dash: 5
    fill: "#ffffff"
  }
  
  TaskHistoryEmb: {
    label: |md
      **Task & History Embeddings**
      (Always Active)
      
      • x'ₜ (Current Task)
      • y'ₜ (History)
    |
    shape: rectangle
    style: {
      fill: "#e8f4f8"
      stroke: "#000000"
      stroke-width: 2
      3d: true
    }
  }
  
  StudentMemoryEmb: {
    label: |md
      **Student Memory**
      (if personalization=true)
      
      • s_gap[uid] (Knowledge Bias)
      • s_vel[uid] (Learning Rate Bias)
    |
    shape: rectangle
    style: {
      fill: "#fff8e8"
      stroke: "#ff8800"
      stroke-width: 2
      stroke-dash: 3
      3d: true
    }
  }
}

InputData: {
  label: Interaction Data
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

StudentIDs: {
  label: |md
    Student IDs
    (conditional)
  |
  shape: cylinder
  style: {
    fill: "#fff8e8"
    stroke: "#ff8800"
    stroke-width: 2
    stroke-dash: 3
  }
}

BKT: {
  label: BKT Priors
  shape: cylinder
  style: {
    fill: "#e8f4f8"
    stroke: "#000000"
    stroke-width: 2
  }
}

# Connections
BKT -> EmbeddingsLayer.TaskHistoryEmb: "p_L0, p_T"
InputData -> EmbeddingsLayer.TaskHistoryEmb: "{(q, c, r)}"
StudentIDs -> EmbeddingsLayer.StudentMemoryEmb: "uid" {
  style: {
    stroke-dash: 3
    stroke: "#ff8800"
  }
}

Legend: {
  shape: rectangle
  label: |md
    **Data Flow:**
    • Solid lines = Always active
    • Dashed lines = Conditional
  |
  style: {
    fill: "#f0f0f0"
    stroke: "#666666"
    stroke-width: 1
  }
}
