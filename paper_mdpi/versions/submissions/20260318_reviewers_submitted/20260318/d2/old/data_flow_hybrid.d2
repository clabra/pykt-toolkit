# Flow - Standard Path
BKT -> TaskEmbeddings: "p_L0, p_T"
InputData -> TaskEmbeddings: "{(q, c, r)}"
TaskEmbeddings -> Transformer
Transformer -> ContextVector
ContextVector -> TheoryBase: "BKT Priors"
ContextVector -> ContextualProjection: "z · Axis"

# Flow - Personalization Path
StudentIDs -> StudentEmbeddings: "uid" {
  style: {
    stroke: "#ff8800"
    stroke-width: 3
  }
}
StudentEmbeddings -> StudentMemory: "s_gap, s_vel" {
  style: {
    stroke: "#ff8800"
    stroke-width: 3
  }
}

# Flow - Composition
TheoryBase -> FinalParams: "+"
ContextualProjection -> FinalParams: "+"
StudentMemory -> FinalParams: "+ (ACTIVE)" {
  style: {
    stroke: "#ff8800"
    stroke-width: 3
  }
}

# Flow - Output
FinalParams -> ReferenceOutput: "p_L0, p_T"
ReferenceOutput -> Prediction

# Note
Note: {
